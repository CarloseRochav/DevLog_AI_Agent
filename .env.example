# DevLog Agent environment.
# Copy to .env and replace the placeholders. .env is not committed.
# The server reads ServerEnv. The indexer reads IndexerEnv and requires VAULT_PATH.

NODE_ENV=development
LOG_LEVEL=info

# v1 means the Foundry /openai/v1 route. That route has no api-version query.
AZURE_OPENAI_ENDPOINT=https://ernes-102010-3838-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=<AZURE_OPENAI_API_KEY>
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_CHAT_DEPLOYMENT=grok-4.6
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_TEMPERATURE=0.2

AZURE_SEARCH_ENDPOINT=https://ai-search-service-charlie.search.windows.net
AZURE_SEARCH_API_KEY=<AZURE_SEARCH_API_KEY>
AZURE_SEARCH_INDEX=devlog-chunks

AZURE_STORAGE_CONNECTION_STRING=<AZURE_STORAGE_CONNECTION_STRING>
AZURE_STORAGE_CONTAINER=devlog-notes

PORT=3000
AGENT_API_KEY=<AGENT_API_KEY>
CORS_ORIGIN=<FRONTEND_ORIGIN_PLACEHOLDER>
HISTORY_MAX_MESSAGES=20

VAULT_PATH=<VAULT_PATH>
VAULT_INCLUDE=devlog-agent/**/*.md
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=80
