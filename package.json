{
  "name": "devlog-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "dev": "tsx apps/cli/src/index.ts",
    "cli": "node --env-file=.env --import tsx apps/cli/src/main.ts",
    "eval": "node --env-file=.env --import tsx apps/cli/src/main.ts eval",
    "smoke:azure": "node --env-file=.env --import tsx scripts/smoke-azure.ts",
    "test:azure": "node --env-file=.env ./node_modules/vitest/vitest.mjs run packages/adapters/src/azure.integration.test.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
